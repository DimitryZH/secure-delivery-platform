              "kubernetes.io/os": "linux"
            },
            "securityContext": {
              "fsGroup": 1000,
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000
            },
            "terminationGracePeriodSeconds": 15,
            "volumes": [
