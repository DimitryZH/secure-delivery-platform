max by (deployment, namespace) (
  kube_deployment_status_replicas_available{
    project_id="${project_id}",
    cluster="${cluster}",
    location="${location}",
    namespace="dev",
    job="kube-state-metrics",
    deployment=~"adservice|cartservice|checkoutservice|currencyservice|emailservice|frontend|paymentservice|productcatalogservice|recommendationservice|shippingservice"
  }
)
